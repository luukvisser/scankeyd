# scan.env: the settings of every scan container (compose.yaml reads it with env_file).
# Copy to scan.env and change; then `docker compose ... up -d` again. All values are checked at
# start: a container with a wrong one stops with a message saying which.

# --- scankeyd -------------------------------------------------------------------------------
# The printer's IPv4 address (required).
PRINTER=192.168.1.50
# The name on the printer's display, 1-16 characters.
TARGET_NAME=Scan
# Not needed with host networking; see README, Networking.
#ADVERTISE_IP=
# 100, 200, 300, 600, 1200 or 2400 dpi (the printer scans at most at its real maximum); a4 or letter.
RESOLUTION=300
PAPER=a4
# Seconds after the last page before a document is finished.
BATCH_TIMEOUT=120

# Per printer function (File, OCR, Image, E-mail on the printer's display):
#   bw, gray or color   the colour mode
#   ,<dpi>              this function's resolution instead of RESOLUTION, e.g. color,600
#   ,ocr                the tidy step adds a searchable text layer
#   ,close / ,single    this page finishes the document / is a document of its own
FUNC_FILE=bw
FUNC_OCR=bw,ocr
FUNC_IMAGE=color
FUNC_EMAIL=bw

# --- Home Assistant (optional): the settings above as entities, changeable there -------------
# Off while MQTT_HOST is empty. A change made in Home Assistant wins over this file until its
# "Back to the settings file" button is pressed. Give scankeyd its own MQTT user, allowed only
# its own topics (README, Home Assistant).
#MQTT_HOST=192.168.1.10
#MQTT_PORT=1883
#MQTT_USERNAME=scankeyd
# The device's id in Home Assistant and in the topics. Chosen at the first start (scankeyd_ plus
# the printer's serial number) and kept in data/; set it to know it in advance, for the ACL.
#MQTT_NODE_ID=scankeyd_office
# The password in a file of its own (mounted), rather than here:
#MQTT_PASSWORD_FILE=/run/secrets/mqtt
#MQTT_TLS=off

# --- the pdf and tidy steps (tidyscan) -----------------------------------------------
# Tesseract languages joined by +, e.g. nld+eng (the image has eng, nld, deu and fra).
OCR_LANGUAGES=eng
# tesseract; paddle (better on receipts) needs the tidyscan:...-paddle image.
OCR_ENGINE=tesseract
# Turn pages upright, straighten crooked ones: auto (when Tesseract is there), on or off.
ROTATE=auto
DESKEW=auto
# PDF/A-2 (archive format) for the documents that get a text layer: on or off. Measured lossless.
PDFA=off

# --- the drive step (rclone) ----------------------------------------------------------------------
# The rclone remote and folder, e.g. drive:Scans; seconds between looks at scans/pdf.
DRIVE_REMOTE=drive:
DRIVE_INTERVAL=15
